# protoc-gen-kotlin: protobuf's kotlin generator behind the plugin
# protocol. protobuf ships the generator inside protoc and no plugin
# executable of its own, so this target links one; the recipe copies
# this directory to `plugins/` in protobuf's source tree and builds
# it there.
cc_binary(
    name = "protoc-gen-kotlin",
    srcs = ["kotlin.cc"],
    deps = [
        "//:protoc_lib",
    ],
)
