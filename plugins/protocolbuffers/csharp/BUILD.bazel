# protoc-gen-csharp: protobuf's C# generator behind the plugin
# protocol. protobuf ships the generator inside protoc and no plugin
# executable of its own, so this target links one; it is placed under
# `plugins/` in protobuf's source tree beside csharp.cc and built
# there.
cc_binary(
    name = "protoc-gen-csharp",
    srcs = ["csharp.cc"],
    deps = [
        "//:protoc_lib",
    ],
)
